<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:controller="org.angelml.system.controller.PersonalController" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@../resources/styles/styles.css" />
   </stylesheets>
   <children>
      <VBox spacing="20.0">
         <padding><Insets bottom="28.0" left="28.0" right="28.0" top="28.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <StackPane styleClass="title-pill"><children><Label styleClass="page-title" text="Personal técnico" /></children></StackPane>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="22.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <TableView fx:id="tblTecnicos" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="NOMBRE" />
            <TableColumn fx:id="colEmail" prefWidth="220.0" text="CORREO" />
            <TableColumn fx:id="colRol" prefWidth="110.0" text="ROL" />
            <TableColumn fx:id="colEstado" prefWidth="90.0" text="ESTADO" />
         </columns>
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
      </TableView>
                        <Label fx:id="lblConteo" styleClass="field-label" />
                     </children>
                  </VBox>
                  <VBox prefWidth="340.0" spacing="14.0" styleClass="card">
                     <children>
                        <Label fx:id="lblFormulario" styleClass="section-title" text="Nuevo técnico" />
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Nombre completo" />
                              <TextField fx:id="txtNombre" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Correo" />
                              <TextField fx:id="txtEmail" promptText="nombre@empresa.com" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Contraseña" />
                              <PasswordField fx:id="pwdPassword" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <Label fx:id="lblPasswordHint" styleClass="field-label" wrapText="true" />
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Rol" />
                              <ComboBox fx:id="cmbRol" maxWidth="Infinity" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <CheckBox fx:id="chkActivo" selected="true" styleClass="check-light" text="Técnico activo" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button fx:id="btnNuevo" onAction="#onNuevo" styleClass="btn-secondary" text="Nuevo" />
                              <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="btn-primary" text="Guardar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
