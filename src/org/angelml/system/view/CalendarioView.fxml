<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:controller="org.angelml.system.controller.CalendarioController" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@../resources/styles/styles.css" />
   </stylesheets>
   <children>
      <VBox spacing="20.0">
         <padding><Insets bottom="28.0" left="28.0" right="28.0" top="28.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <StackPane styleClass="title-pill"><children><Label styleClass="page-title" text="Calendario" /></children></StackPane>
                  <Region HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="tglDia" selected="true" styleClass="toggle-range" text="Día" />
                  <ToggleButton fx:id="tglSemana" styleClass="toggle-range" text="Semana" />
                  <DatePicker fx:id="dpFecha" prefWidth="160.0" styleClass="glass-input" />
                  <Button fx:id="btnHoy" onAction="#onHoy" styleClass="btn-secondary" text="Hoy" />
               </children>
            </HBox>
            <HBox spacing="22.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblRango" styleClass="section-title" />
                        <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colFecha" prefWidth="90.0" text="FECHA" />
            <TableColumn fx:id="colHora" prefWidth="60.0" text="HORA" />
            <TableColumn fx:id="colTitulo" prefWidth="210.0" text="TÍTULO" />
            <TableColumn fx:id="colTecnico" prefWidth="130.0" text="TÉCNICO" />
            <TableColumn fx:id="colEstado" prefWidth="90.0" text="ESTADO" />
         </columns>
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
      </TableView>
                     </children>
                  </VBox>
                  <VBox prefWidth="340.0" spacing="14.0" styleClass="card">
                     <children>
                        <Label fx:id="lblFormulario" styleClass="section-title" text="Nueva cita" />
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Título" />
                              <TextField fx:id="txtTitulo" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Descripción" />
                              <TextArea fx:id="txaDescripcion" prefHeight="72.0" prefRowCount="2" styleClass="glass-input" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Fecha" />
                                    <DatePicker fx:id="dpFechaCita" maxWidth="Infinity" styleClass="glass-input" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label styleClass="field-label" text="Hora" />
                                    <TextField fx:id="txtHora" prefWidth="80.0" promptText="14:30" styleClass="glass-input" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="field-label" text="Técnico" />
                              <ComboBox fx:id="cmbTecnico" maxWidth="Infinity" styleClass="glass-input" />
                           </children>
                        </VBox>
                        <Label fx:id="lblSeleccion" styleClass="field-label" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button fx:id="btnNueva" onAction="#onNueva" styleClass="btn-secondary" text="Nueva" />
                              <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="btn-primary" text="Guardar" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button fx:id="btnCompletar" onAction="#onCompletar" styleClass="btn-secondary" text="Marcar completada" />
                              <Button fx:id="btnEliminar" onAction="#onEliminar" styleClass="btn-danger" text="Eliminar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
